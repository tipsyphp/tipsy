{
	"name": "tipsyphp/tipsy",
	"description": "An MVW PHP framework",
	"license": "MIT",
	"time": "2014-07-24",
	"keywords": [
		"php",
		"mvw",
		"mvc",
		"framework"
	],
	"authors": [
		{
			"name": "Devin Smith",
			"email": "git@arzynik.com",
			"homepage": "https://devin.la",
			"role": "Developer"
		}
	],
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0"
	},
	"autoload": {
		"psr-4": {
			"Tipsy\\": "src/"
		},
		"files": ["src/Tipsy.php"]
	},
	"scripts": {
		"test": "php -d short_open_tag=1 vendor/bin/phpunit --configuration tests/phpunit.xml --no-coverage",
		"test:coverage": "php -d short_open_tag=1 vendor/bin/phpunit --configuration tests/phpunit.xml"
	},
	"archive": {
		"exclude": ["/tests", "/examples", "/benchmarks", "/.github", "/.gitignore"]
	}
}
